EXPO_PUBLIC_NAVORA_API_URL="http://localhost:8000"

# Localização automática por beacon (Bluetooth). Só funciona no APK de
# desenvolvimento (não no Expo Go). Sem esta linha, ou com "false", o app usa
# só a escolha manual da entrada. Ver docs/beacons-configuracao.md.
EXPO_PUBLIC_BLE_ENABLED="false"

# Telefone da recepção de cada unidade (só dígitos, com DDD) para o botão
# "Ligar para a recepção" do SOS. Vazio = botão não aparece.
EXPO_PUBLIC_RECEPTION_PHONE_PRIVATE=
EXPO_PUBLIC_RECEPTION_PHONE_SUS=

# Chave do Google Maps (tela "Como chegar ao hospital"). Lida pelo app.config.js
# na hora do build — NUNCA colocar no app.json (o repositório é público).
# Build EAS na nuvem: cadastrar como variável do EAS, não aqui. Ver
# docs/seguranca-chaves.md.
GOOGLE_MAPS_API_KEY=
