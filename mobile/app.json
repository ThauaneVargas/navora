{
  "expo": {
    "name": "Navora",
    "slug": "navora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icone_app.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icone_app.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdge": true
    },
    "web": {
      "favicon": "./assets/images/icone_app.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-audio",
      "expo-location",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icone_app.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ]
  }
}
