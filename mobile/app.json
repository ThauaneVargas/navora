{
  "expo": {
    "name": "Navora",
    "slug": "navora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icone_app.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.navora.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyDCmuG1j9cHkWDUKm17061ECLmdjlgqGiw"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icone_app_adaptive.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.navora.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDCmuG1j9cHkWDUKm17061ECLmdjlgqGiw"
        }
      }
    },
    "web": {
      "favicon": "./assets/images/icone_app.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Navora usa sua localização só na tela \"Como chegar ao hospital\", para mostrar o caminho até a entrada. Ela não é guardada."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Navora acessa suas fotos só quando você escolhe uma foto para o seu perfil.",
          "cameraPermission": "O Navora usa a câmera só quando você tira uma foto para o seu perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Navora usa o Face ID para você entrar na sua conta sem digitar a senha."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icone_app.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "react-native-ble-manager",
        {
          "isBleRequired": false,
          "neverForLocation": false,
          "bluetoothAlwaysPermission": "O Navora usa o Bluetooth para reconhecer os pontos de referência do hospital e mostrar onde você está. Só funciona com o app aberto."
        }
      ],
      "./plugins/withShortCmakeStaging",
      "./plugins/withReleaseMinifyOff",
      "./plugins/withNoAutofillHighlight"
    ]
  }
}
