{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_NAVORA_API_URL": "https://navora-backend-kpio.onrender.com",
        "EXPO_PUBLIC_BLE_ENABLED": "true",
        "EXPO_PUBLIC_BEACON_DIAGNOSTICS": "false",
        "EXPO_PUBLIC_RECEPTION_PHONE_PRIVATE": "2424718381",
        "EXPO_PUBLIC_RECEPTION_PHONE_SUS": "2424718381"
      }
    },
    "apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
